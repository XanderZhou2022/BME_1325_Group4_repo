# 复制为 .env 并填入真实 key（勿提交 .env）

GENAI_API_URL=https://genaiapi.shanghaitech.edu.cn/api/v1/start

# 各模型 API Key（与教学网分配一致）
KEY_GPT52=
KEY_DEEPSEEK_V32=
KEY_DEEPSEEK_R1=
