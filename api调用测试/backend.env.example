# 复制本文件中的变量到：BME_1325_Group4_repo/system/backend/api/.env
# （与 api调用测试/.env 中的教学网关配置对应，便于两边用同一套 Key）

# PostgreSQL（按你本机修改）
ICU_PG_DSN=dbname=icu_agent user=postgres password=YOUR_PASSWORD host=localhost port=5432

ICU_CORS_ORIGINS=*

# 与 call_genai.py --profile deepseek_v32 使用同一网关与模型
ICU_LLM_ENABLED=true

# 与 api调用测试/.env 中 GENAI_API_URL 一致
ICU_LLM_BASE_URL=https://genaiapi.shanghaitech.edu.cn/api/v1/start

# 与 api调用测试/.env 中 KEY_DEEPSEEK_V32 一致
ICU_LLM_API_KEY=

# 与 api调用测试/.env 中 MODEL_DEEPSEEK_V32 一致（默认 deepseek-v3:671b）
ICU_LLM_MODEL=deepseek-v3:671b

# 可选：合同环境变量（无 ICU_ 前缀）
# HOSPITAL_LLM_GATEWAY_URL=https://genaiapi.shanghaitech.edu.cn/api/v1/start
# HOSPITAL_LLM_API_KEY=
