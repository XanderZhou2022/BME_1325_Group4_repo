        \"-3\": [],
        \"-4\": [\"≤49\"]
      }
    },
    {
      \"id\": 3,
      \"name\": \"心率\",
      \"name_en\": \"Heart Rate\",
      \"unit\": \"次/min\",
      \"scores\": {
