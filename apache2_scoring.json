    {
      \"id\": 4,
      \"name\": \"呼吸频率\",
      \"name_en\": \"Respiratory Rate\",
      \"unit\": \"次/min\",
      \"note\": \"机械或非机械通气\",
      \"scores\": {
        \"+4\": [\"≥50\"],
        \"+3\": [\"35-49\"],
        \"+2\": [],
        \"+1\": [\"25-34\"],
        \"0\": [\"12-24\"],
        \"-1\": [\"10-11\"],
        \"-2\": [\"6-9\"],
        \"-3\": [],
