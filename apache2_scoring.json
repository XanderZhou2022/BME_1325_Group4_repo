        \"-3\": [\"30.0-31.9\"],
        \"-4\": [\"≤29.9\"]
      }
    },
    {
      \"id\": 2,
      \"name\": \"平均动脉压\",
      \"name_en\": \"Mean Arterial Pressure\",
      \"unit\": \"mmHg\",
      \"scores\": {
        \"+4\": [\"≥160\"],
        \"+3\": [\"130-159\"],
        \"+2\": [\"110-129\"],
        \"+1\": [],
