"{
  \"name\": \"APACHE II Scoring System\",
  \"description\": \"急性生理与慢性健康评分系统 II (Acute Physiology And Chronic Health Evaluation II)\",
  \"version\": \"1.0\",
  \"physiological_parameters\": [
    {
      \"id\": 1,
      \"name\": \"直肠温度\",
      \"name_en\": \"Rectal Temperature\",
      \"unit\": \"°C\",
      \"scores\": {
        \"+4\": [\"≥41.0\"],
        \"+3\": [\"39.0-40.9\"],
        \"+2\": [],
