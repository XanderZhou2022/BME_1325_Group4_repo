        \"-2\": [\"2.5-2.9\"],
        \"-3\": [],
        \"-4\": [\"<2.5\"]
      }
    },
    {
      \"id\": 9,
      \"name\": \"血清肌酐\",
      \"name_en\": \"Serum Creatinine\",
      \"unit\": \"mg/dL 或 μmol/L\",
      \"note\": \"急性肾功能衰竭患者的分值加倍\",
      \"scores\": {
        \"+4\": [\"≥3.5\"],
        \"+3\": [\"2.0-3.4\"],
        \"+2\": [\"1.5-1.9\"],
        \"+1\": [],
        \"0\": [\"0.6-1.4\"],
        \"-1\": [],
        \"-2\": [\"<0.6\"],
        \"-3\": [],
        \"-4\": []
      },
      \"arf_multiplier\": 2
    },
    {
      \"id\": 10,
      \"name\": \"血细胞比容\",
      \"name_en\": \"Hematocrit\",
      \"unit\": \"%\",
      \"scores\": {
        \"+4\": [\"≥60\"],
        \"+3\": [],
        \"+2\": [\"50.0-59.9\"],
        \"+1\": [\"46.0-49.9\"],
        \"0\": [\"30.0-45.9\"],
        \"-1\": [],
        \"-2\": [\"20.0-29.9\"],
        \"-3\": [],
        \"-4\": [\"<20\"]
      }
    },
    {
      \"id\": 11,
      \"name\": \"白细胞计数\",
      \"name_en\": \"White Blood Cell Count\",
      \"unit\": \"×1000/μL\",
      \"scores\": {
        \"+4\": [\"≥40\"],
        \"+3\": [],
        \"+2\": [\"20.0-39.9\"],
        \"+1\": [\"15.0-19.9\"],
        \"0\": [\"3.0-14.9\"],
        \"-1\": [],
        \"-2\": [\"1.0-2.9\"],
        \"-3\": [],
        \"-4\": [\"<1\"]
      }
    },
    {
      \"id\": 12,
      \"name\": \"格拉斯哥昏迷评分\",
      \"name_en\": \"Glasgow Coma Scale\",
      \"unit\": \"GCS\",
      \"note\": \"GCS 分数 = 15 - 实际 GCS 分值\",
      \"calculation\": \"15 - actual_gcs\",
      \"scores\": {
        \"0\": [\"15\"],
        \"1\": [\"14\"],
        \"2\": [\"13\"],
        \"3\": [\"12\"],
        \"4\": [\"11\"],
        \"5\": [\"10\"],
        \"6\": [\"9\"],
        \"7\": [\"8\"],
        \"8\": [\"7\"],
        \"9\": [\"6\"],
        \"10\": [\"5\"],
        \"11\": [\"4\"],
        \"12\": [\"3\"],
        \"13\": [\"2\"],
        \"14\": [\"1\"],
        \"15\": [\"0\"]
      }
    }
  ],
  \"age_points\": {
    \"description\": \"年龄评分\",
    \"ranges\": [
      {\"age_range\": \"<44\", \"points\": 0},
      {\"age_range\": \"45-54\", \"points\": 2},
      {\"age_range\": \"55-64\", \"points\": 3},
      {\"age_range\": \"65-74\", \"points\": 5},
      {\"age_range\": \"≥75\", \"points\": 6}
    ]
  },
  \"chronic_health_points\": {
    \"description\": \"慢性健康评分\",
    \"conditions\": \"免疫低下或有严重器官功能不全史\",
    \"scores\": [
      {\"type\": \"择期手术\", \"points\": 2},
      {\"type\": \"未手术治疗或急诊术后\", \"points\": 5}
    ]
  },
  \"optional_parameter\": {
    \"id\": 13,
    \"name\": \"血清碳酸氢盐\",
    \"name_en\": \"Serum Bicarbonate\",
    \"unit\": \"mmol/L 或 mEq/L\",
    \"note\": \"静脉血 - 可选参数\",
    \"scores\": {
      \"+4\": [\"≥52\"],
      \"+3\": [\"41-51.9\"],
      \"+2\": [],
      \"+1\": [\"32-40.9\"],
      \"0\": [\"22-31.9\"],
      \"-1\": [],
      \"-2\": [\"18-21.9\"],
      \"-3\": [\"15-17.9\"],
      \"-4\": [\"<15\"]
    }
  },
  \"calculation\": {
    \"total_score\": \"急性生理学评分 (12 项参数得分总和) + 年龄评分 + 慢性健康评分\",
    \"formula\": \"APS + Age_Points + Chronic_Health_Points\",
    \"score_range\": \"0-71\",
    \"interpretation\": {
      \"low_risk\": \"0-9 分，死亡率约 0.5%\",
      \"medium_risk\": \"10-19 分，死亡率约 5-25%\",
      \"high_risk\": \"20-29 分，死亡率约 30-60%\",
      \"very_high_risk\": \"≥30 分，死亡率约 70-90%\"
    }
  },
  \"references\": [
    \"Knaus WA, Draper EA, Wagner DP, Zimmerman JE. APACHE II: a severity of disease classification system. Crit Care Med. 1985;13(10):818-829.\"
  ]
}"