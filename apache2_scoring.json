    {
      \"id\": 5,
      \"name\": \"氧合\",
      \"name_en\": \"Oxygenation\",
      \"unit\": \"mmHg\",
      \"sub_parameters\": [
        {
          \"condition\": \"FiO2 ≥ 0.5\",
          \"method\": \"A-aDO2\",
          \"scores\": {
            \"+4\": [\"≥500\"],
            \"+3\": [\"350-499\"],
            \"+2\": [\"200-349\"],
            \"+1\": [],
            \"0\": [\"<200\"]
          }
        },
        {
          \"condition\": \"FiO2 < 0.5\",
          \"method\": \"PaO2\",
          \"scores\": {
            \"+4\": [],
            \"+3\": [],
            \"+2\": [],
            \"+1\": [],
            \"0\": [\">70\"],
            \"-1\": [\"61-70\"],
            \"-2\": [],
            \"-3\": [\"55-60\"],
            \"-4\": [\"<55\"]
          }
        }
      ]
    },
    {
      \"id\": 6,
      \"name\": \"动脉血 pH\",
      \"name_en\": \"Arterial pH\",
      \"unit\": \"pH\",
      \"scores\": {
        \"+4\": [\"≥7.70\"],
        \"+3\": [\"7.60-7.69\"],
        \"+2\": [],
        \"+1\": [\"7.50-7.59\"],
        \"0\": [\"7.33-7.49\"],
        \"-1\": [],
        \"-2\": [\"7.25-7.32\"],
        \"-3\": [\"7.15-7.24\"],
        \"-4\": [\"<7.15\"]
      }
    },
    {
      \"id\": 7,
      \"name\": \"血清钠\",
      \"name_en\": \"Serum Sodium\",
      \"unit\": \"mmol/L 或 mEq/L\",
      \"scores\": {
        \"+4\": [\"≥180\"],
        \"+3\": [\"160-179\"],
        \"+2\": [\"155-159\"],
        \"+1\": [\"150-154\"],
        \"0\": [\"130-149\"],
        \"-1\": [],
        \"-2\": [\"120-129\"],
        \"-3\": [\"111-119\"],
        \"-4\": [\"≤110\"]
      }
    },
    {
      \"id\": 8,
      \"name\": \"血清钾\",
      \"name_en\": \"Serum Potassium\",
      \"unit\": \"mmol/L 或 mEq/L\",
      \"scores\": {
        \"+4\": [\"≥7.0\"],
        \"+3\": [\"6.0-6.9\"],
        \"+2\": [],
        \"+1\": [\"5.5-5.9\"],
        \"0\": [\"3.5-5.4\"],
