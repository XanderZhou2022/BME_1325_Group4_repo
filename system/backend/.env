# system/backend/.env（遗留说明文件；后端实际读取 system/backend/api/.env）

# 数据库连接 (PostgreSQL)
ICU_PG_DSN="dbname=icu_agent user=postgres password=您的密码 host=localhost port=5432"

# LLM：统一使用仓库根目录 api调用测试/.env（DASHSCOPE_API_KEY、DASHSCOPE_MODEL）
# 本地验证：cd api调用测试 && python api使用.py
# 后端开关：在 system/backend/api/.env 中设置 ICU_LLM_ENABLED=true
