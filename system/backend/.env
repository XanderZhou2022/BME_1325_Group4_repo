# system/backend/.env

# 数据库连接 (PostgreSQL)
# 格式: dbname=库名 user=用户名 password=密码 host=地址 port=端口
ICU_PG_DSN="dbname=icu_agent user=postgres password=您的密码 host=localhost port=5432"

# AI / LLM 配置 (预留)
# 虽然第二层 Agent 目前主要依靠规则运行，但为了系统完整性及未来扩展（如生成报告），请填入 Key。
OPENAI_API_KEY="bb336cff66f54e7a9d6f48b3dba97657"
OPENAI_MODEL="GPT-5.2"

# 如果您使用本地模型 (如 Ollama, DeepSeek 等)，请取消注释并修改 URL
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="deepseek-r1"